# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by .gitignore and must never be committed.

# Database URL (default: app.db at the repository root)
DATABASE_URL=sqlite:///./app.db

# Secret key used to sign session cookies (required).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Session lifetime in seconds (optional, default: 86400 = 1 day)
# SESSION_MAX_AGE_SECONDS=86400

# Set to true only when the site is served over HTTPS (optional, default: false).
# If true on a plain-HTTP deployment, browsers will not send the cookie and login fails.
# SESSION_COOKIE_SECURE=false
